# Base de données (SQLite par défaut, migrable vers Postgres)
DATABASE_URL="file:./dev.db"

# Mot de passe unique pour te connecter au dashboard
ADMIN_PASSWORD="change-moi"

# Secret utilisé pour signer le cookie de session (mets une longue chaîne aléatoire)
AUTH_SECRET="remplace-par-une-longue-chaine-aleatoire-de-32-caracteres-min"

# URL publique de l'app, utilisée pour générer les liens partagés aux clients
# En local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
